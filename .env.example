# APP_URL: The public HTTPS URL where this Mini App is hosted (auto-injected by AI Studio; set manually on Render/Koyeb).
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Get one for free from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=""

# ADMIN_TELEGRAM_IDS: Your numeric Telegram User ID (from @userinfobot) to auto-unlock hidden Admin controls only for you.
ADMIN_TELEGRAM_IDS=""

# ADMIN_PIN: Secret PIN to unlock Admin controls via ?admin=1 or tapping "Cartela 24/7" 5 times.
ADMIN_PIN="1234"

# TELEGRAM_USE_POLLING: Keep "false" when hosted online (uses webhook at /api/telegram/webhook), or "true" for local polling.
TELEGRAM_USE_POLLING="false"

# Optional Starting Defaults
COMMISSION_PERCENT="20"
CALL_INTERVAL_SECONDS="3.5"
INITIAL_DEPOSIT_BIRR="100"

# Supabase Persistence (100% Free Tier — paste from Supabase Project Settings -> API)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN_GROUP_ID: Optional numeric Telegram Group ID (-100...) for Deposit/Withdraw requests (or run /setgroup inside the group)
ADMIN_GROUP_ID=""

